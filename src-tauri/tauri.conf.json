{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qomicex Launcher",
  "mainBinaryName": "Qomicex Launcher",
  "version": "0.1.0",
  "identifier": "com.tauri-app.qomicex-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Qomicex Launcher",
        "width": 1140,
        "height": 790,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": true,
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5000 http://127.0.0.1:5000 ws://localhost:5000 ws://127.0.0.1:5000 qomicex: http://qomicex.localhost https://api.github.com blob: data:; img-src 'self' blob: asset: http://localhost:5000 http://127.0.0.1:5000 qomicex: http://qomicex.localhost data: https:; style-src 'self' 'unsafe-inline' http://localhost:5000 http://127.0.0.1:5000 qomicex: http://qomicex.localhost; font-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' http://localhost:5000 http://127.0.0.1:5000 qomicex: http://qomicex.localhost blob: data:; worker-src 'self' blob: data:; frame-src 'self' blob:; media-src 'self' asset:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1REQ2QUU1MzMwMUFCRTMKUldUanF3RXo1V3JkTmZpa2EvMFc1L3VSNTRURGhKTkJTeTJnUnl2eHhEZWZlWHZlWENiMWEvY2gK",
      "endpoints": [
        "http://127.0.0.1:5000/api/update/manifest?current_version={{current_version}}&target={{target}}&arch={{arch}}",
        "https://api.qomicex.top/api/client/update/manifest?current_version={{current_version}}&target={{target}}&arch={{arch}}"
      ]
    }
  }
}

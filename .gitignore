node_modules/
.pnpm-store/
backend.err

# Frontend build
dist/

# Rust build output: 一条规则覆盖 src-tauri/ 与所有 src-backend crate。
# 原先是两个按目录写死的规则，新增 crate 时会漏。
target/

# Legacy C# backend runtime leftovers (deleted source; dir contains a test
# artifact with an NTFS-reserved name that cannot be removed via Win32 APIs)
src-backend/Qomicex.Launcher.Backend.Neo/
src-backend/Qomicex.Connector.Part.Scaffolding/
src-backend/Qomicex.Core.AOT/
src-backend/Qomicex.Downloader.Refactor/

# VS junk
.vs/

# Runtime data: 只忽略实际产生数据的目录。原来无锚定的 `data/` 会连带吞掉
# 任何层级的 data 目录（如未来的 src/data/）。
/.shots-home/data/

# Minecraft runtime files
.minecraft/


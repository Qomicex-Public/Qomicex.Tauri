# LoongArch64 基础构建镜像
FROM loongarch64/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    PATH=/root/.cargo/bin:/usr/local/bin:$PATH

# 安装系统依赖（Tauri + 后端构建 + 打包工具）
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    rpm \
    xdg-utils \
    libglib2.0-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# 安装 Rust（stable 工具链）
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

# 安装 Node.js 20.11.1（Loongnix 官方 LoongArch64 二进制）
RUN curl -fsSL https://ftp.loongnix.cn/nodejs/LoongArch/dist/v20.11.1/node-v20.11.1-linux-loong64.tar.xz \
    | tar -xJ -C /usr/local --strip-components=1

# 安装 pnpm
RUN npm install -g pnpm@9

# 设置工作目录
WORKDIR /workspace

CMD ["/bin/bash"]

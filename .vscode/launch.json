{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "启动 Tauri",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "tauri",
                "dev"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
            }
        },
        {
            "name": "启动 Rust 后端",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "cargo",
            "runtimeArgs": [
                "run",
                "--manifest-path",
                "${workspaceFolder}/src-backend/qomicex-backend/Cargo.toml"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
            }
        },
        {
            "name": "启动 Rust 后端 (许可证验证)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "cargo",
            "runtimeArgs": [
                "run",
                "--manifest-path",
                "${workspaceFolder}/src-backend/qomicex-backend/Cargo.toml",
                "--features",
                "license-required"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
            }
        },
        {
            "name": "调试 Rust 后端",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build-backend-rust",
            "program": "${workspaceFolder}/src-backend/qomicex-backend/target/debug/qomicex-backend.exe",
            "cwd": "${workspaceFolder}/src-backend/qomicex-backend",
            "console": "integratedTerminal",
            "sourceLanguages": [
                "rust"
            ],
            "env": {}
        },
        {
            "name": "调试 Rust 后端 (许可证验证)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build-backend-rust-license",
            "program": "${workspaceFolder}/src-backend/qomicex-backend/target/debug/qomicex-backend.exe",
            "cwd": "${workspaceFolder}/src-backend/qomicex-backend",
            "console": "integratedTerminal",
            "sourceLanguages": [
                "rust"
            ],
            "env": {}
        }
    ],
    "compounds": [
        {
            "name": "启动 Qomicex.Tauri",
            "configurations": [
                "启动 Rust 后端",
                "启动 Tauri"
            ],
            "stopAll": true
        },
        {
            "name": "启动 Qomicex.Tauri (许可证验证)",
            "configurations": [
                "启动 Rust 后端 (许可证验证)",
                "启动 Tauri"
            ],
            "stopAll": true
        },
        {
            "name": "启动 Qomicex.Tauri (Rust 后端调试)",
            "configurations": [
                "调试 Rust 后端",
                "启动 Tauri"
            ],
            "stopAll": true
        },
        {
            "name": "启动 Qomicex.Tauri (Rust 后端调试, 许可证验证)",
            "configurations": [
                "调试 Rust 后端 (许可证验证)",
                "启动 Tauri"
            ],
            "stopAll": true
        }
    ]
}
